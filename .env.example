# Pilih: fake, gemini, openrouter, atau groq.
# fake menjalankan pipeline tanpa API key.
PROVIDER=gemini

# Gemini (opsional; hanya dibutuhkan bila PROVIDER=gemini)
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash

# OpenRouter (opsional; pilih model di openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
# Set true hanya bila model terpilih mendukung fitur tersebut.
OPENROUTER_VISION=true
OPENROUTER_STRUCTURED_OUTPUT=true

# Groq (opsional; lihat console.groq.com/docs/models)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Qwen vision model di dokumentasi Groq mendukung kedua fitur ini.
GROQ_VISION=false
GROQ_STRUCTURED_OUTPUT=true

# Resiliensi
MAX_CONCURRENCY=2
REQUESTS_PER_MINUTE=15
MAX_RETRIES=3
PROVIDER_TIMEOUT_S=60
CACHE_ENABLED=false

# Dokumen
RENDER_DPI=150
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000
MAX_INSTRUCTION_CHARS=10000
MAX_ACTIVE_RUNS=4
RUN_TTL_MINUTES=60
MAX_STORED_RUNS=100

# Server
HOST=0.0.0.0
PORT=8000
