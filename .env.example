# Provider (ARCHITECTURE.md §8, TECH_STACK_DECISIONS.md §7)
# Adapter default. Gunakan `fake` untuk menjalankan seluruh pipeline tanpa API key.
PROVIDER=fake
# Diisi hanya jika PROVIDER=gemini. Jangan commit nilai asli.
GEMINI_API_KEY=
MODEL_NAME=gemini-2.0-flash

# Resiliensi
MAX_CONCURRENCY=2
REQUESTS_PER_MINUTE=15
MAX_RETRIES=3
CACHE_ENABLED=false

# Dokumen
RENDER_DPI=150
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000

# Server
HOST=0.0.0.0
PORT=8000
