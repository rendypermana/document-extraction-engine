# Choose one: fake, gemini, openrouter, or groq.
# The fake provider runs the pipeline without an API key.
PROVIDER=gemini

# Gemini (optional; required only when PROVIDER=gemini)
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash

# OpenRouter (optional; choose a model at openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
# Set these to true only when the selected model supports the corresponding feature.
OPENROUTER_VISION=true
OPENROUTER_STRUCTURED_OUTPUT=true

# Groq (optional; see console.groq.com/docs/models)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# The Qwen vision model listed in the Groq documentation supports both features.
GROQ_VISION=false
GROQ_STRUCTURED_OUTPUT=true

# Resilience
MAX_CONCURRENCY=2
REQUESTS_PER_MINUTE=15
MAX_RETRIES=3
PROVIDER_TIMEOUT_S=60

# Document processing
RENDER_DPI=150
OCR_ENABLED=true
OCR_LANGUAGE=ind+eng
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000
MAX_INSTRUCTION_CHARS=10000
MAX_ACTIVE_RUNS=4
RUN_TTL_MINUTES=60
MAX_STORED_RUNS=100

# Server
HOST=0.0.0.0
PORT=8000
