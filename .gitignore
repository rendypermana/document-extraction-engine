# Project documentation is maintained locally and must not be committed.
docs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Local tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets and local configuration
.env
.env.*
!.env.example

# Tailwind CLI, marked and DOMPurify are build-only inputs: Node compiles the
# stylesheet and vendors the two libraries into static/ during the Docker build.
node_modules/

# Compiled Tailwind output. Generated by `npm run build:css`; the Docker build
# produces its own copy, so the repository does not track it.
static/css/app.css

# Vendored third-party browser builds, copied by `npm run vendor`.
static/js/vendor/

